# Copy to .env and fill in real values. .env is gitignored — do not commit it.

# Port the backend listens on
PORT=5000

# MongoDB connection string
# Local:  mongodb://127.0.0.1:27017/lab_evaluation
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lab_evaluation
MONGO_URI=mongodb://127.0.0.1:27017/lab_evaluation

# Secret used to sign JWTs. Generate a fresh one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_me_with_a_long_random_string
